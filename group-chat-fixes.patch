--- a/frontend/src/store/groupSlice.ts
+++ b/frontend/src/store/groupSlice.ts
@@ -36,12 +36,16 @@
 const apiCall = async (
   url: string,
   options?: RequestInit
 ): Promise<Response> => {
-  const res = await fetch(url, {
-    headers: { 'Content-Type': 'application/json' },
-    ...options,
-  });
+  const token = localStorage.getItem('accessToken');
+  const res = await fetch(url, {
+    ...options,
+    headers: {
+      'Content-Type': 'application/json',
+      ...(token ? { Authorization: `Bearer ${token}` } : {}),
+      ...(options?.headers ?? {}),
+    },
+  });
   if (!res.ok) {
     const msg = await res.text().catch(() => res.statusText);
     throw new Error(msg);
   }
   return res;
 };

